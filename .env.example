# Doxhund engine configuration (copy to .env and fill in as needed).
# Defaults are safe for local development in demo mode.

DOXHUND_MODE=demo
DOXHUND_CORS_ORIGINS=*
DOXHUND_PROXY_URL=
DOXHUND_CAPTCHA_PROVIDER=capsolver
DOXHUND_CAPTCHA_API_KEY=
DOXHUND_REQUEST_TIMEOUT_S=15
DOXHUND_MAX_BROKERS_PER_SCAN=4
DOXHUND_RATE_LIMIT_REQUESTS=10
DOXHUND_RATE_LIMIT_WINDOW_S=60
DOXHUND_TURNSTILE_SECRET=
